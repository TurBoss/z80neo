   10 REM Lissajous curves - VDP bitmap (DVI) demo
   20 MODE 1
   30 CLG
   40 GCOL 3
   50 FOR T=0 TO 1000 STEP 2
   60 X=320+300*SIN(T/100)
   70 Y=128+120*SIN(T/50+0.7)
   80 IF T=0 THEN MOVE X,Y ELSE DRAW X,Y
   90 NEXT
  100 GCOL 1
  110 FOR T=0 TO 1000 STEP 2
  120 X=320+300*SIN(T/70+1.5)
  130 Y=128+120*SIN(T/30)
  140 IF T=0 THEN MOVE X,Y ELSE DRAW X,Y
  150 NEXT
RUN
