   400  0235  da0902            	JP	C,SYNERR
   401  0238  c8                	RET	Z		;check for valid delimiter.
   402  0239  fe3d              	CP	'='
   403  023b  c8                	RET	Z
   404  023c  fe5f              	CP	'_'
   405  023e  c8                	RET	Z
   406  023f  fe2e              	CP	'.'
   407  0241  c8                	RET	Z
   408  0242  fe3a              	CP	':'
