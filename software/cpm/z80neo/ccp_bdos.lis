              1715320d1d152315  
  1289  088b  2c15331547154d15  	DEFW	GETPARM,GETUSER,RDRANDOM,WTRANDOM,FILESIZE,SETRAN,LOGOFF,RTN
              5315141459150a0b  
  1290  089b  0a0ba115          	DEFW	RTN,WTSPECL
