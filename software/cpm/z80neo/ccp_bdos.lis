  1537  0a32  e5                	PUSH	HL
  1538  0a33  cdcf09            	CALL	OUTCRLF
  1539  0a36  af                	XOR	A		;and update starting position.
  1540  0a37  32110b            	LD	(STARTING),A
  1541  0a3a  c3f709            	JP	RDBUF2
  1542  0a3d  fe10              RDBUF5:	CP	CNTRLP		;control-p?
  1543  0a3f  c24e0a            	JP	NZ,RDBUF6
  1544  0a42  e5                	PUSH	HL		;yes, flip the print flag filp-flop byte.
  1545  0a43  21130b            	LD	HL,PRTFLAG
  1546  0a46  3e01              	LD	A,1		;PRTFLAG=1-PRTFLAG
  1547  0a48  96                	SUB	(HL)
  1548  0a49  77                	LD	(HL),A
  1549  0a4a  e1                	POP	HL
  1550  0a4b  c3f509            	JP	RDBUF1
  1551  0a4e  fe18              RDBUF6:	CP	CNTRLX		;control-x (cancel)?
