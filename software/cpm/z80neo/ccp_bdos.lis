  1469  09bc  cdcf09            	CALL	OUTCRLF		;start new line.
  1470  09bf  3a120b            NEWLN1:	LD	A,(CURPOS)	;move the cursor to the starting position.
  1471  09c2  21110b            	LD	HL,STARTING
  1472  09c5  be                	CP	(HL)
  1473  09c6  d0                	RET	NC		;there yet?
  1474  09c7  0e20              	LD	C,' '
  1475  09c9  cd4e09            	CALL	OUTCHAR		;nope, keep going.
  1476  09cc  c3bf09            	JP	NEWLN1
  1477                          ;
  1478                          ;   Output a (cr) (lf) to the console device (screen).
  1479                          ;
  1480  09cf  0e0d              OUTCRLF:LD	C,CR
  1481  09d1  cd4e09            	CALL	OUTCHAR
  1482  09d4  0e0a              	LD	C,LF
  1483  09d6  c34e09            	JP	OUTCHAR
