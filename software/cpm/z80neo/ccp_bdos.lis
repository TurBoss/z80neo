  1118  06fd  7d                	LD	A,L
  1119  06fe  93                	SUB	E
  1120  06ff  7c                	LD	A,H
  1121  0700  9a                	SBC	A,D
  1122  0701  d27707            	JP	NC,UNKWN0	;no, it can't fit.
  1123  0704  c3e706            	JP	UNKWN3
  1124                          ;
  1125                          ;   Get here after finished reading.
  1126                          ;
  1127  0707  e1                UNKWN4:	POP	HL
  1128  0708  3d                	DEC	A		;normal end of file?
  1129  0709  c27707            	JP	NZ,UNKWN0
  1130  070c  cd6c04            	CALL	RESETDR		;yes, reset previous drive.
  1131  070f  cd5e02            	CALL	CONVFST		;convert the first file name that follows
  1132  0712  21f607            	LD	HL,CHGDRV	;command name.
  1133  0715  e5                	PUSH	HL
