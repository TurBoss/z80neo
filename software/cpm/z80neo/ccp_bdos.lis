   445  0263  cd5902            	CALL	ADDHL
   446  0266  e5                	PUSH	HL
   447  0267  e5                	PUSH	HL
   448  0268  af                	XOR	A
   449  0269  32f607            	LD	(CHGDRV),A	;initialize drive change flag.
   450  026c  2a8800            	LD	HL,(INPOINT)	;set (HL) as pointer into input line.
   451  026f  eb                	EX	DE,HL
   452  0270  cd4f02            	CALL	NONBLANK	;get next non-blank character.
   453  0273  eb                	EX	DE,HL
   454  0274  228a00            	LD	(NAMEPNT),HL	;save pointer here for any error message.
   455  0277  eb                	EX	DE,HL
   456  0278  e1                	POP	HL
   457  0279  1a                	LD	A,(DE)		;get first character.
   458  027a  b7                	OR	A
   459  027b  ca8902            	JP	Z,CONVRT1
