  1146  0730  cd4804            	CALL	HL2DE
  1147  0733  210800            	LD	HL,INBUFF+2	;now move the remainder of the input
  1148  0736  7e                UNKWN5:	LD	A,(HL)		;line down to (0080h). Look for a non blank.
  1149  0737  b7                	OR	A		;or a null.
  1150  0738  ca4407            	JP	Z,UNKWN6
  1151  073b  fe20              	CP	' '
