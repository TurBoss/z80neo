  1004  0616  cd5e02            RENAME:	CALL	CONVFST		;convert first file name.
  1005  0619  c20902            	JP	NZ,SYNERR	;wild cards not allowed.
  1006  061c  3af607            	LD	A,(CHGDRV)	;remember any change in drives specified.
  1007  061f  f5                	PUSH	AF
  1008  0620  cd5a04            	CALL	DSELECT		;and select this drive.
  1009  0623  cde900            	CALL	SRCHFCB		;is this file present?
  1010  0626  c27f06            	JP	NZ,RENAME6	;yes, print error message.
  1011  0629  21d307            	LD	HL,FCB		;yes, move this name into second slot.
  1012  062c  11e307            	LD	DE,FCB+16
  1013  062f  0610              	LD	B,16
  1014  0631  cd4804            	CALL	HL2DE
