   792  047d  cd5e02            DIRECT:	CALL	CONVFST		;convert file name.
   793  0480  cd5a04            	CALL	DSELECT		;select indicated drive.
   794  0483  21d407            	LD	HL,FCB+1	;was any file indicated?
   795  0486  7e                	LD	A,(HL)
   796  0487  fe20              	CP	' '
   797  0489  c29504            	JP	NZ,DIRECT2
   798  048c  060b              	LD	B,11		;no. Fill field with '?' - same as *.*.
   799  048e  363f              DIRECT1:LD	(HL),'?'
   800  0490  23                	INC	HL
   801  0491  05                	DEC	B
   802  0492  c28e04            	JP	NZ,DIRECT1
   803  0495  1e00              DIRECT2:LD	E,0		;set initial cursor position.
   804  0497  d5                	PUSH	DE
   805  0498  cde900            	CALL	SRCHFCB		;get first file name.
   806  049b  ccf003            	CALL	Z,NONE		;none found at all?
   807  049e  ca2105            DIRECT3:JP	Z,DIRECT9	;terminate if no more names.
   808  04a1  3af407            	LD	A,(RTNCODE)	;get file's position in segment (0-3).
   809  04a4  0f                	RRCA
   810  04a5  0f                	RRCA
   811  04a6  0f                	RRCA
   812  04a7  e660              	AND	60H		;(A)=position*32
   813  04a9  4f                	LD	C,A
   814  04aa  3e0a              	LD	A,10
   815  04ac  cd5104            	CALL	EXTRACT		;extract the tenth entry in fcb.
   816  04af  17                	RLA			;check system file status bit.
   817  04b0  da1505            	JP	C,DIRECT8	;we don't list them.
   818  04b3  d1                	POP	DE
   819  04b4  7b                	LD	A,E		;bump name count.
   820  04b5  1c                	INC	E
   821  04b6  d5                	PUSH	DE
   822  04b7  e603              	AND	03H		;at end of line?
   823  04b9  f5                	PUSH	AF
   824  04ba  c2d204            	JP	NZ,DIRECT4
   825  04bd  cd9800            	CALL	CRLF		;yes, end this line and start another.
   826  04c0  c5                	PUSH	BC
   827  04c1  cdd001            	CALL	GETDSK		;start line with ('A:').
   828  04c4  c1                	POP	BC
   829  04c5  c641              	ADD	A,'A'
   830  04c7  cd9200            	CALL	PRINTB
   831  04ca  3e3a              	LD	A,':'
   832  04cc  cd9200            	CALL	PRINTB
   833  04cf  c3da04            	JP	DIRECT5
   834  04d2  cda200            DIRECT4:CALL	SPACE		;add seperator between file names.
   835  04d5  3e3a              	LD	A,':'
   836  04d7  cd9200            	CALL	PRINTB
   837  04da  cda200            DIRECT5:CALL	SPACE
   838  04dd  0601              	LD	B,1		;'extract' each file name character at a time.
   839  04df  78                DIRECT6:LD	A,B
   840  04e0  cd5104            	CALL	EXTRACT
   841  04e3  e67f              	AND	7FH		;strip bit 7 (status bit).
   842  04e5  fe20              	CP	' '		;are we at the end of the name?
   843  04e7  c2ff04            	JP	NZ,DRECT65
   844  04ea  f1                	POP	AF		;yes, don't print spaces at the end of a line.
   845  04eb  f5                	PUSH	AF
   846  04ec  fe03              	CP	3
   847  04ee  c2fd04            	JP	NZ,DRECT63
   848  04f1  3e09              	LD	A,9		;first check for no extension.
   849  04f3  cd5104            	CALL	EXTRACT
   850  04f6  e67f              	AND	7FH
   851  04f8  fe20              	CP	' '
   852  04fa  ca1405            	JP	Z,DIRECT7	;don't print spaces.
   853  04fd  3e20              DRECT63:LD	A,' '		;else print them.
   854  04ff  cd9200            DRECT65:CALL	PRINTB
   855  0502  04                	INC	B		;bump to next character psoition.
   856  0503  78                	LD	A,B
   857  0504  fe0c              	CP	12		;end of the name?
   858  0506  d21405            	JP	NC,DIRECT7
   859  0509  fe09              	CP	9		;nope, starting extension?
   860  050b  c2df04            	JP	NZ,DIRECT6
   861  050e  cda200            	CALL	SPACE		;yes, add seperating space.
   862  0511  c3df04            	JP	DIRECT6
   863  0514  f1                DIRECT7:POP	AF		;get the next file name.
   864  0515  cdc201            DIRECT8:CALL	CHKCON		;first check console, quit on anything.
   865  0518  c22105            	JP	NZ,DIRECT9
