  1492  09df  4f                	LD	C,A
  1493  09e0  cd9609            	CALL	OUTCON
  1494  09e3  c1                	POP	BC
  1495  09e4  c3d909            	JP	PRTMESG
  1496                          ;
  1497                          ;   Function to execute a buffered read.
  1498                          ;
  1499  09e7  3a120b            RDBUFF:	LD	A,(CURPOS)	;use present location as starting one.
  1500  09ea  32110b            	LD	(STARTING),A
  1501  09ed  2a490b            	LD	HL,(PARAMS)	;get the maximum buffer space.
  1502  09f0  4e                	LD	C,(HL)
  1503  09f1  23                	INC	HL		;point to first available space.
  1504  09f2  e5                	PUSH	HL		;and save.
  1505  09f3  0600              	LD	B,0		;keep a character count.
  1506  09f5  c5                RDBUF1:	PUSH	BC
  1507  09f6  e5                	PUSH	HL
  1508  09f7  cd0109            RDBUF2:	CALL	GETCHAR		;get the next input character.
  1509  09fa  e67f              	AND	7FH		;strip bit 7.
  1510  09fc  e1                	POP	HL		;reset registers.
  1511  09fd  c1                	POP	BC
  1512  09fe  fe0d              	CP	CR		;en of the line?
  1513  0a00  cac70a            	JP	Z,RDBUF17
  1514  0a03  fe0a              	CP	LF
  1515  0a05  cac70a            	JP	Z,RDBUF17
  1516  0a08  fe08              	CP	BS		;how about a backspace?
  1517  0a0a  c21c0a            	JP	NZ,RDBUF3
  1518  0a0d  78                	LD	A,B		;yes, but ignore at the beginning of the line.
  1519  0a0e  b7                	OR	A
  1520  0a0f  caf509            	JP	Z,RDBUF1
  1521  0a12  05                	DEC	B		;ok, update counter.
  1522  0a13  3a120b            	LD	A,(CURPOS)	;if we backspace to the start of the line,
  1523  0a16  32100b            	LD	(OUTFLAG),A	;treat as a cancel (control-x).
  1524  0a19  c3760a            	JP	RDBUF10
  1525  0a1c  fe7f              RDBUF3:	CP	DEL		;user typed a rubout?
  1526  0a1e  c22c0a            	JP	NZ,RDBUF4
  1527  0a21  78                	LD	A,B		;ignore at the start of the line.
  1528  0a22  b7                	OR	A
  1529  0a23  caf509            	JP	Z,RDBUF1
  1530  0a26  7e                	LD	A,(HL)		;ok, echo the prevoius character.
  1531  0a27  05                	DEC	B		;and reset pointers (counters).
  1532  0a28  2b                	DEC	HL
  1533  0a29  c3af0a            	JP	RDBUF15
  1534  0a2c  fe05              RDBUF4:	CP	CNTRLE		;physical end of line?
