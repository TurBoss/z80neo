  1239                          ;
  1240                          ;   Bdos error table.
  1241                          ;
  1242  080f  9f08              BADSCTR:DEFW	ERROR1		;bad sector on read or write.
  1243  0811  ab08              BADSLCT:DEFW	ERROR2		;bad disk select.
  1244  0813  b108              RODISK:	DEFW	ERROR3		;disk is read only.
  1245  0815  b708              ROFILE:	DEFW	ERROR4		;file is read only.
  1246                          ;
  1247                          ;   Entry into bdos. (DE) or (E) are the parameters passed. The
  1248                          ; function number desired is in register (C).
  1249                          ;
  1250  0817  eb                FBASE1:	EX	DE,HL		;save the (DE) parameters.
  1251  0818  22490b            	LD	(PARAMS),HL
  1252  081b  eb                	EX	DE,HL
  1253  081c  7b                	LD	A,E		;and save register (E) in particular.
  1254  081d  32dc15            	LD	(EPARAM),A
  1255  0820  210000            	LD	HL,0
  1256  0823  224b0b            	LD	(STATUS),HL	;clear return status.
  1257  0826  39                	ADD	HL,SP
  1258  0827  22150b            	LD	(USRSTACK),HL	;save users stack pointer.
  1259  082a  31470b            	LD	SP,STKAREA	;and set our own.
  1260  082d  af                	XOR	A		;clear auto select storage space.
  1261  082e  32e615            	LD	(AUTOFLAG),A
  1262  0831  32e415            	LD	(AUTO),A
  1263  0834  217a15            	LD	HL,GOBACK	;set return address.
  1264  0837  e5                	PUSH	HL
  1265  0838  79                	LD	A,C		;get function number.
  1266  0839  fe29              	CP	NFUNCTS		;valid function number?
  1267  083b  d0                	RET	NC
  1268  083c  4b                	LD	C,E		;keep single register function here.
  1269  083d  214d08            	LD	HL,FUNCTNS	;now look thru the function table.
  1270  0840  5f                	LD	E,A
  1271  0841  1600              	LD	D,0		;(DE)=function number.
  1272  0843  19                	ADD	HL,DE
  1273  0844  19                	ADD	HL,DE		;(HL)=(start of table)+2*(function number).
  1274  0845  5e                	LD	E,(HL)
  1275  0846  23                	INC	HL
  1276  0847  56                	LD	D,(HL)		;now (DE)=address for this function.
  1277  0848  2a490b            	LD	HL,(PARAMS)	;retrieve parameters.
  1278  084b  eb                	EX	DE,HL		;now (DE) has the original parameters.
  1279  084c  e9                	JP	(HL)		;execute desired function.
