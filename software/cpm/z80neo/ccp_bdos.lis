  1292                          ;   Bdos error message section.
  1293                          ;
  1294  089f  21d008            ERROR1:	LD	HL,BADSEC	;bad sector message.
  1295  08a2  cdeb08            	CALL	PRTERR		;print it and get a 1 char responce.
  1296  08a5  fe03              	CP	CNTRLC		;re-boot request (control-c)?
  1297  08a7  ca0000            	JP	Z,0		;yes.
  1298  08aa  c9                	RET			;no, return to retry i/o function.
  1299                          ;
  1300  08ab  21db08            ERROR2:	LD	HL,BADSEL	;bad drive selected.
  1301  08ae  c3ba08            	JP	ERROR5
  1302                          ;
  1303  08b1  21e708            ERROR3:	LD	HL,DISKRO	;disk is read only.
  1304  08b4  c3ba08            	JP	ERROR5
  1305                          ;
  1306  08b7  21e208            ERROR4:	LD	HL,FILERO	;file is read only.
  1307                          ;
  1308  08ba  cdeb08            ERROR5:	CALL	PRTERR
  1309  08bd  c30000            	JP	0		;always reboot on these errors.
  1310                          ;
  1311  08c0  42646f7320457272  BDOSERR:DEFB	"Bdos Err On "
              204f6e20          
  1312  08cc  203a2024          BDOSDRV:DEFB	" : $"
  1313  08d0  4261642053656374  BADSEC:	DEFB	"Bad Sector$"
              6f7224            
  1314  08db  53656c65637424    BADSEL:	DEFB	"Select$"
  1315  08e2  46696c6520        FILERO:	DEFB	"File "
  1316  08e7  522f4f24          DISKRO:	DEFB	"R/O$"
  1317                          ;
  1318                          ;   Print bdos error message.
  1319                          ;
  1320  08eb  e5                PRTERR:	PUSH	HL		;save second message pointer.
  1321  08ec  cdcf09            	CALL	OUTCRLF		;send (cr)(lf).
  1322  08ef  3a480b            	LD	A,(ACTIVE)	;get active drive.
  1323  08f2  c641              	ADD	A,'A'		;make ascii.
  1324  08f4  32cc08            	LD	(BDOSDRV),A	;and put in message.
  1325  08f7  01c008            	LD	BC,BDOSERR	;and print it.
  1326  08fa  cdd909            	CALL	PRTMESG
  1327  08fd  c1                	POP	BC		;print second message line now.
  1328  08fe  cdd909            	CALL	PRTMESG
  1329                          ;
  1330                          ;   Get an input character. We will check our 1 character
  1331                          ; buffer first. This may be set by the console status routine.
  1332                          ;
  1333  0901  21140b            GETCHAR:LD	HL,CHARBUF	;check character buffer.
  1334  0904  7e                	LD	A,(HL)		;anything present already?
  1335  0905  3600              	LD	(HL),0		;...either case clear it.
  1336  0907  b7                	OR	A
  1337  0908  c0                	RET	NZ		;yes, use it.
  1338  0909  c309eb            	JP	CONIN		;nope, go get a character responce.
  1339                          ;
  1340                          ;   Input and echo a character.
  1341                          ;
  1342  090c  cd0109            GETECHO:CALL	GETCHAR		;input a character.
  1343  090f  cd1a09            	CALL	CHKCHAR		;carriage control?
  1344  0912  d8                	RET	C		;no, a regular control char so don't echo.
  1345  0913  f5                	PUSH	AF		;ok, save character now.
  1346  0914  4f                	LD	C,A
  1347  0915  cd9609            	CALL	OUTCON		;and echo it.
  1348  0918  f1                	POP	AF		;get character and return.
  1349  0919  c9                	RET
  1350                          ;
  1351                          ;   Check character in (A). Set the zero flag on a carriage
  1352                          ; control character and the carry flag on any other control
  1353                          ; character.
  1354                          ;
  1355  091a  fe0d              CHKCHAR:CP	CR		;check for carriage return, line feed, backspace,
  1356  091c  c8                	RET	Z		;or a tab.
  1357  091d  fe0a              	CP	LF
  1358  091f  c8                	RET	Z
  1359  0920  fe09              	CP	TAB
  1360  0922  c8                	RET	Z
  1361  0923  fe08              	CP	BS
  1362  0925  c8                	RET	Z
  1363  0926  fe20              	CP	' '		;other control char? Set carry flag.
  1364  0928  c9                	RET
  1365                          ;
  1366                          ;   Check the console during output. Halt on a control-s, then
  1367                          ; reboot on a control-c. If anything else is ready, clear the
  1368                          ; zero flag and return (the calling routine may want to do
  1369                          ; something).
  1370                          ;
  1371  0929  3a140b            CKCONSOL: LD	A,(CHARBUF)	;check buffer.
  1372  092c  b7                	OR	A		;if anything, just return without checking.
  1373  092d  c24b09            	JP	NZ,CKCON2
  1374  0930  cd06eb            	CALL	CONST		;nothing in buffer. Check console.
  1375  0933  e601              	AND	01H		;look at bit 0.
  1376  0935  c8                	RET	Z		;return if nothing.
  1377  0936  cd09eb            	CALL	CONIN		;ok, get it.
  1378  0939  fe13              	CP	CNTRLS		;if not control-s, return with zero cleared.
  1379  093b  c24809            	JP	NZ,CKCON1
  1380  093e  cd09eb            	CALL	CONIN		;halt processing until another char
  1381  0941  fe03              	CP	CNTRLC		;is typed. Control-c?
  1382  0943  ca0000            	JP	Z,0		;yes, reboot now.
  1383  0946  af                	XOR	A		;no, just pretend nothing was ever ready.
  1384  0947  c9                	RET
  1385  0948  32140b            CKCON1:	LD	(CHARBUF),A	;save character in buffer for later processing.
  1386  094b  3e01              CKCON2:	LD	A,1		;set (A) to non zero to mean something is ready.
  1387  094d  c9                	RET
  1388                          ;
  1389                          ;   Output (C) to the screen. If the printer flip-flop flag
  1390                          ; is set, we will send character to printer also. The console
  1391                          ; will be checked in the process.
  1392                          ;
  1393  094e  3a100b            OUTCHAR:LD	A,(OUTFLAG)	;check output flag.
  1394  0951  b7                	OR	A		;anything and we won't generate output.
  1395  0952  c26809            	JP	NZ,OUTCHR1
  1396  0955  c5                	PUSH	BC
  1397  0956  cd2909            	CALL	CKCONSOL	;check console (we don't care whats there).
  1398  0959  c1                	POP	BC
  1399  095a  c5                	PUSH	BC
  1400  095b  cd0ceb            	CALL	CONOUT		;output (C) to the screen.
  1401  095e  c1                	POP	BC
  1402  095f  c5                	PUSH	BC
  1403  0960  3a130b            	LD	A,(PRTFLAG)	;check printer flip-flop flag.
  1404  0963  b7                	OR	A
  1405  0964  c40feb            	CALL	NZ,LIST		;print it also if non-zero.
  1406  0967  c1                	POP	BC
  1407  0968  79                OUTCHR1:LD	A,C		;update cursors position.
  1408  0969  21120b            	LD	HL,CURPOS
  1409  096c  fe7f              	CP	DEL		;rubouts don't do anything here.
  1410  096e  c8                	RET	Z
  1411  096f  34                	INC	(HL)		;bump line pointer.
  1412  0970  fe20              	CP	' '		;and return if a normal character.
  1413  0972  d0                	RET	NC
  1414  0973  35                	DEC	(HL)		;restore and check for the start of the line.
  1415  0974  7e                	LD	A,(HL)
  1416  0975  b7                	OR	A
  1417  0976  c8                	RET	Z		;ingnore control characters at the start of the line.
  1418  0977  79                	LD	A,C
  1419  0978  fe08              	CP	BS		;is it a backspace?
  1420  097a  c27f09            	JP	NZ,OUTCHR2
  1421  097d  35                	DEC	(HL)		;yes, backup pointer.
  1422  097e  c9                	RET
  1423  097f  fe0a              OUTCHR2:CP	LF		;is it a line feed?
  1424  0981  c0                	RET	NZ		;ignore anything else.
  1425  0982  3600              	LD	(HL),0		;reset pointer to start of line.
  1426  0984  c9                	RET
  1427                          ;
  1428                          ;   Output (A) to the screen. If it is a control character
  1429                          ; (other than carriage control), use ^x format.
  1430                          ;
  1431  0985  79                SHOWIT:	LD	A,C
  1432  0986  cd1a09            	CALL	CHKCHAR		;check character.
  1433  0989  d29609            	JP	NC,OUTCON	;not a control, use normal output.
  1434  098c  f5                	PUSH	AF
  1435  098d  0e5e              	LD	C,'^'		;for a control character, preceed it with '^'.
  1436  098f  cd4e09            	CALL	OUTCHAR
  1437  0992  f1                	POP	AF
  1438  0993  f640              	OR	'@'		;and then use the letter equivelant.
  1439  0995  4f                	LD	C,A
  1440                          ;
  1441                          ;   Function to output (C) to the console device and expand tabs
  1442                          ; if necessary.
  1443                          ;
  1444  0996  79                OUTCON:	LD	A,C
  1445  0997  fe09              	CP	TAB		;is it a tab?
  1446  0999  c24e09            	JP	NZ,OUTCHAR	;use regular output.
  1447  099c  0e20              OUTCON1:LD	C,' '		;yes it is, use spaces instead.
  1448  099e  cd4e09            	CALL	OUTCHAR
  1449  09a1  3a120b            	LD	A,(CURPOS)	;go until the cursor is at a multiple of 8
  1450                          
  1451  09a4  e607              	AND	07H		;position.
  1452  09a6  c29c09            	JP	NZ,OUTCON1
  1453  09a9  c9                	RET
  1454                          ;
  1455                          ;   Echo a backspace character. Erase the prevoius character
  1456                          ; on the screen.
  1457                          ;
  1458  09aa  cdb209            BACKUP:	CALL	BACKUP1		;backup the screen 1 place.
  1459  09ad  0e20              	LD	C,' '		;then blank that character.
  1460  09af  cd0ceb            	CALL	CONOUT
  1461  09b2  0e08              BACKUP1:LD	C,BS		;then back space once more.
  1462  09b4  c30ceb            	JP	CONOUT
  1463                          ;
  1464                          ;   Signal a deleted line. Print a '#' at the end and start
  1465                          ; over.
  1466                          ;
  1467  09b7  0e23              NEWLINE:LD	C,'#'
