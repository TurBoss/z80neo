   546                          ;
   547                          ;   CP/M command table. Note commands can be either 3 or 4 characters long.
   548                          ;
   549                          NUMCMDS EQU	6		;number of commands
   550  0310  4449522000        CMDTBL:	DEFB	"DIR ",0
   551  0315  4552412000        	DEFB	"ERA ",0
   552  031a  5459504500        	DEFB	"TYPE",0
   553  031f  5341564500        	DEFB	"SAVE",0
   554  0324  52454e2000        	DEFB	"REN ",0
   555  0329  5553455200        	DEFB	"USER",0
   556                          ;
   557                          ;   The following six bytes must agree with those at (PATTRN2)
   558                          ; or cp/m will HALT. Why?
   559                          ;
   560  032e  001600000000      PATTRN1:DEFB	0,22,0,0,0,0	;(* serial number bytes *).
   561                          ;
   562                          ;   Search the command table for a match with what has just
   563                          ; been entered. If a match is found, then we jump to the
   564                          ; proper section. Else jump to (UNKNOWN).
   565                          ; On return, the (C) register is set to the command number
   566                          ; that matched (or NUMCMDS+1 if no match).
   567                          ;
   568  0334  211003            SEARCH:	LD	HL,CMDTBL
   569  0337  0e00              	LD	C,0
   570  0339  79                SEARCH1:LD	A,C
   571  033a  fe06              	CP	NUMCMDS		;this commands exists.
   572  033c  d0                	RET	NC
   573  033d  11d407            	LD	DE,FCB+1	;check this one.
   574  0340  0604              	LD	B,4		;max command length.
   575  0342  1a                SEARCH2:LD	A,(DE)
   576  0343  be                	CP	(HL)
   577  0344  c25503            	JP	NZ,SEARCH3	;not a match.
   578  0347  13                	INC	DE
   579  0348  23                	INC	HL
   580  0349  05                	DEC	B
   581  034a  c24203            	JP	NZ,SEARCH2
   582  034d  1a                	LD	A,(DE)		;allow a 3 character command to match.
   583  034e  fe20              	CP	' '
   584  0350  c25a03            	JP	NZ,SEARCH4
   585  0353  79                	LD	A,C		;set return register for this command.
   586  0354  c9                	RET
   587  0355  23                SEARCH3:INC	HL
   588  0356  05                	DEC	B
   589  0357  c25503            	JP	NZ,SEARCH3
   590  035a  0c                SEARCH4:INC	C
   591  035b  c33903            	JP	SEARCH1
   592                          ;
   593                          ;   Set the input buffer to empty and then start the command
   594                          ; processor (ccp).
   595                          ;
   596  035e  af                CLEARBUF: XOR	A
   597  035f  320700            	LD	(INBUFF+1),A	;second byte is actual length.
   598                          ;
   599                          ;**************************************************************
   600                          ;*
   601                          ;*
   602                          ;* C C P  -   C o n s o l e   C o m m a n d   P r o c e s s o r
   603                          ;*
   604                          ;**************************************************************
   605                          ;*
   606  0362  31b107            COMMAND:LD	SP,CCPSTACK	;setup stack area.
   607  0365  c5                	PUSH	BC		;note that (C) should be equal to:
   608  0366  79                	LD	A,C		;(uuuudddd) where 'uuuu' is the user number
   609  0367  1f                	RRA			;and 'dddd' is the drive number.
   610  0368  1f                	RRA
   611  0369  1f                	RRA
   612  036a  1f                	RRA
   613  036b  e60f              	AND	0FH		;isolate the user number.
   614  036d  5f                	LD	E,A
   615  036e  cd1501            	CALL	GETSETUC	;and set it.
   616  0371  cdb800            	CALL	RESDSK		;reset the disk system.
   617  0374  32b107            	LD	(BATCH),A	;clear batch mode flag.
   618  0377  c1                	POP	BC
   619  0378  79                	LD	A,C
   620  0379  e60f              	AND	0FH		;isolate the drive number.
   621  037b  32f507            	LD	(CDRIVE),A	;and save.
   622  037e  cdbd00            	CALL	DSKSEL		;...and select.
   623  0381  3a0700            	LD	A,(INBUFF+1)
   624  0384  b7                	OR	A		;anything in input buffer already?
   625  0385  c29e03            	JP	NZ,CMMND2	;yes, we just process it.
   626                          ;
   627                          ;   Entry point to get a command line from the console.
   628                          ;
   629  0388  31b107            CMMND1:	LD	SP,CCPSTACK	;set stack straight.
   630  038b  cd9800            	CALL	CRLF		;start a new line on the screen.
   631  038e  cdd001            	CALL	GETDSK		;get current drive.
   632  0391  c661              	ADD	A,'a'
   633  0393  cd8c00            	CALL	PRINT		;print current drive.
   634  0396  3e3e              	LD	A,'>'
   635  0398  cd8c00            	CALL	PRINT		;and add prompt.
   636  039b  cd3901            	CALL	GETINP		;get line from user.
   637                          ;
   638                          ;   Process command line here.
   639                          ;
   640  039e  118000            CMMND2:	LD	DE,TBUFF
   641  03a1  cdd801            	CALL	DMASET		;set standard dma address.
   642  03a4  cdd001            	CALL	GETDSK
   643  03a7  32f507            	LD	(CDRIVE),A	;set current drive.
   644  03aa  cd5e02            	CALL	CONVFST		;convert name typed in.
   645  03ad  c40902            	CALL	NZ,SYNERR	;wild cards are not allowed.
   646  03b0  3af607            	LD	A,(CHGDRV)	;if a change in drives was indicated,
   647  03b3  b7                	OR	A		;then treat this as an unknown command
   648  03b4  c2ab06            	JP	NZ,UNKNOWN	;which gets executed.
   649  03b7  cd3403            	CALL	SEARCH		;else search command table for a match.
   650                          ;
   651                          ;   Note that an unknown command returns
   652                          ; with (A) pointing to the last address
   653                          ; in our table which is (UNKNOWN).
   654                          ;
   655  03ba  21c703            	LD	HL,CMDADR	;now, look thru our address table for command (A).
   656  03bd  5f                	LD	E,A		;set (DE) to command number.
   657  03be  1600              	LD	D,0
   658  03c0  19                	ADD	HL,DE
   659  03c1  19                	ADD	HL,DE		;(HL)=(CMDADR)+2*(command number).
   660  03c2  7e                	LD	A,(HL)		;now pick out this address.
   661  03c3  23                	INC	HL
   662  03c4  66                	LD	H,(HL)
   663  03c5  6f                	LD	L,A
   664  03c6  e9                	JP	(HL)		;now execute it.
   665                          ;
   666                          ;   CP/M command address table.
   667                          ;
   668  03c7  7d0425056305b305  CMDADR:	DEFW	DIRECT,ERASE,TYPE,SAVE
   669  03cf  16069406ab06      	DEFW	RENAME,USER,UNKNOWN
   670                          ;
   671                          ;   Halt the system. Reason for this is unknown at present.
   672                          ;
   673  03d5  21f376            HALT:	LD	HL,76F3H	;'DI HLT' instructions.
   674  03d8  220000            	LD	(CBASE),HL
   675  03db  210000            	LD	HL,CBASE
   676  03de  e9                	JP	(HL)
   677                          ;
   678                          ;   Read error while TYPEing a file.
   679                          ;
   680  03df  01e503            RDERROR:LD	BC,RDERR
   681  03e2  c3a700            	JP	PLINE
   682  03e5  5265616420657272  RDERR:	DEFB	"Read error",0
              6f7200            
   683                          ;
   684                          ;   Required file was not located.
   685                          ;
   686  03f0  01f603            NONE:	LD	BC,NOFILE
   687  03f3  c3a700            	JP	PLINE
   688  03f6  4e6f2066696c6500  NOFILE:	DEFB	"No file",0
   689                          ;
   690                          ;   Decode a command of the form 'A>filename number{ filename}.
   691                          ; Note that a drive specifier is not allowed on the first file
   692                          ; name. On return, the number is in register (A). Any error
   693                          ; causes 'filename?' to be printed and the command is aborted.
   694                          ;
   695  03fe  cd5e02            DECODE:	CALL	CONVFST		;convert filename.
   696  0401  3af607            	LD	A,(CHGDRV)	;do not allow a drive to be specified.
   697  0404  b7                	OR	A
   698  0405  c20902            	JP	NZ,SYNERR
   699  0408  21d407            	LD	HL,FCB+1	;convert number now.
   700  040b  010b00            	LD	BC,11		;(B)=sum register, (C)=max digit count.
   701  040e  7e                DECODE1:LD	A,(HL)
   702  040f  fe20              	CP	' '		;a space terminates the numeral.
   703  0411  ca3904            	JP	Z,DECODE3
   704  0414  23                	INC	HL
   705  0415  d630              	SUB	'0'		;make binary from ascii.
   706  0417  fe0a              	CP	10		;legal digit?
   707  0419  d20902            	JP	NC,SYNERR
   708  041c  57                	LD	D,A		;yes, save it in (D).
   709  041d  78                	LD	A,B		;compute (B)=(B)*10 and check for overflow.
   710  041e  e6e0              	AND	0E0H
   711  0420  c20902            	JP	NZ,SYNERR
   712  0423  78                	LD	A,B
   713  0424  07                	RLCA
   714  0425  07                	RLCA
   715  0426  07                	RLCA			;(A)=(B)*8
   716  0427  80                	ADD	A,B		;.......*9
   717  0428  da0902            	JP	C,SYNERR
   718  042b  80                	ADD	A,B		;.......*10
   719  042c  da0902            	JP	C,SYNERR
   720  042f  82                	ADD	A,D		;add in new digit now.
   721  0430  da0902            DECODE2:JP	C,SYNERR
   722  0433  47                	LD	B,A		;and save result.
   723  0434  0d                	DEC	C		;only look at 11 digits.
   724  0435  c20e04            	JP	NZ,DECODE1
   725  0438  c9                	RET
   726  0439  7e                DECODE3:LD	A,(HL)		;spaces must follow (why?).
   727  043a  fe20              	CP	' '
   728  043c  c20902            	JP	NZ,SYNERR
   729  043f  23                	INC	HL
   730  0440  0d                DECODE4:DEC	C
   731  0441  c23904            	JP	NZ,DECODE3
   732  0444  78                	LD	A,B		;set (A)=the numeric value entered.
   733  0445  c9                	RET
   734                          ;
   735                          ;   Move 3 bytes from (HL) to (DE). Note that there is only
   736                          ; one reference to this at (A2D5h).
   737                          ;
   738  0446  0603              MOVE3:	LD	B,3
   739                          ;
   740                          ;   Move (B) bytes from (HL) to (DE).
   741                          ;
   742  0448  7e                HL2DE:	LD	A,(HL)
   743  0449  12                	LD	(DE),A
   744  044a  23                	INC	HL
   745  044b  13                	INC	DE
   746  044c  05                	DEC	B
   747  044d  c24804            	JP	NZ,HL2DE
   748  0450  c9                	RET
   749                          ;
   750                          ;   Compute (HL)=(TBUFF)+(A)+(C) and get the byte that's here.
   751                          ;
   752  0451  218000            EXTRACT:LD	HL,TBUFF
   753  0454  81                	ADD	A,C
   754  0455  cd5902            	CALL	ADDHL
   755  0458  7e                	LD	A,(HL)
   756  0459  c9                	RET
   757                          ;
   758                          ;  Check drive specified. If it means a change, then the new
   759                          ; drive will be selected. In any case, the drive byte of the
   760                          ; fcb will be set to null (means use current drive).
   761                          ;
   762  045a  af                DSELECT:XOR	A		;null out first byte of fcb.
   763  045b  32d307            	LD	(FCB),A
   764  045e  3af607            	LD	A,(CHGDRV)	;a drive change indicated?
   765  0461  b7                	OR	A
   766  0462  c8                	RET	Z
   767  0463  3d                	DEC	A		;yes, is it the same as the current drive?
   768  0464  21f507            	LD	HL,CDRIVE
   769  0467  be                	CP	(HL)
   770  0468  c8                	RET	Z
   771  0469  c3bd00            	JP	DSKSEL		;no. Select it then.
   772                          ;
   773                          ;   Check the drive selection and reset it to the previous
   774                          ; drive if it was changed for the preceeding command.
   775                          ;
   776  046c  3af607            RESETDR:LD	A,(CHGDRV)	;drive change indicated?
   777  046f  b7                	OR	A
   778  0470  c8                	RET	Z
   779  0471  3d                	DEC	A		;yes, was it a different drive?
   780  0472  21f507            	LD	HL,CDRIVE
   781  0475  be                	CP	(HL)
   782  0476  c8                	RET	Z
   783  0477  3af507            	LD	A,(CDRIVE)	;yes, re-select our old drive.
   784  047a  c3bd00            	JP	DSKSEL
