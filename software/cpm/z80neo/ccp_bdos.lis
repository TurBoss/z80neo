   905                          ;
   906  0563  cd5e02            TYPE:	CALL	CONVFST		;convert file name.
   907  0566  c20902            	JP	NZ,SYNERR	;wild cards not allowed.
   908  0569  cd5a04            	CALL	DSELECT		;select indicated drive.
   909  056c  cdd000            	CALL	OPENFCB		;open the file.
   910  056f  caad05            	JP	Z,TYPE5		;not there?
   911  0572  cd9800            	CALL	CRLF		;ok, start a new line on the screen.
   912  0575  21f707            	LD	HL,NBYTES	;initialize byte counter.
   913  0578  36ff              	LD	(HL),0FFH	;set to read first sector.
   914  057a  21f707            TYPE1:	LD	HL,NBYTES
   915  057d  7e                TYPE2:	LD	A,(HL)		;have we written the entire sector?
   916  057e  fe80              	CP	128
   917  0580  da8d05            	JP	C,TYPE3
