  1027  0650  f1                	POP	AF		;if a drive was specified, then it
  1028  0651  47                	LD	B,A		;must be the same as before.
  1029  0652  21f607            	LD	HL,CHGDRV
  1030  0655  7e                	LD	A,(HL)
