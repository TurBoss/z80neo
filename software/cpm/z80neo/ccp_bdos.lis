  1017  0638  cd4f02            	CALL	NONBLANK	;get next non blank character.
  1018  063b  fe3d              	CP	'='		;only allow an '=' or '_' seperator.
  1019  063d  ca4506            	JP	Z,RENAME1
  1020  0640  fe5f              	CP	'_'
  1021  0642  c27906            	JP	NZ,RENAME5
