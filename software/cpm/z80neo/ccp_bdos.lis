   511  02d9  77                GETEXT2:LD	(HL),A
   512  02da  13                	INC	DE
   513  02db  05                GETEXT3:DEC	B
   514  02dc  c2c802            	JP	NZ,GETEXT1
   515  02df  cd3002            GETEXT4:CALL	CHECK
