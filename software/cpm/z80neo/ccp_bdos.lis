   923  058c  77                	LD	(HL),A
   924  058d  34                TYPE3:	INC	(HL)		;count this byte.
   925  058e  218000            	LD	HL,TBUFF	;and get the (A)th one from the buffer (TBUFF).
   926  0591  cd5902            	CALL	ADDHL
   927  0594  7e                	LD	A,(HL)
   928  0595  fe1a              	CP	CNTRLZ		;end of file mark?
   929  0597  ca8c07            	JP	Z,GETBACK
   930  059a  cd8c00            	CALL	PRINT		;no, print it.
   931  059d  cdc201            	CALL	CHKCON		;check console, quit if anything ready.
   932  05a0  c28c07            	JP	NZ,GETBACK
   933  05a3  c37a05            	JP	TYPE1
   934                          ;
   935                          ;   Get here on an end of file or read error.
   936                          ;
   937  05a6  3d                TYPE4:	DEC	A		;read error?
   938  05a7  ca8c07            	JP	Z,GETBACK
   939  05aa  cddf03            	CALL	RDERROR		;yes, print message.
   940  05ad  cd6c04            TYPE5:	CALL	RESETDR		;and reset proper drive
