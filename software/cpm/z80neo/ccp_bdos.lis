  1078  06ab  cdf501            UNKNOWN:CALL	VERIFY		;check for valid system (why?).
  1079  06ae  3ad407            	LD	A,(FCB+1)	;anything to execute?
  1080  06b1  fe20              	CP	' '
  1081  06b3  c2ca06            	JP	NZ,UNKWN1
