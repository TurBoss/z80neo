   949  05b3  cdfe03            SAVE:	CALL	DECODE		;get numeric number that follows SAVE.
   950  05b6  f5                	PUSH	AF		;save number of pages to write.
   951  05b7  cd5e02            	CALL	CONVFST		;convert file name.
   952  05ba  c20902            	JP	NZ,SYNERR	;wild cards not allowed.
   953  05bd  cd5a04            	CALL	DSELECT		;select specified drive.
   954  05c0  11d307            	LD	DE,FCB		;now delete this file.
   955  05c3  d5                	PUSH	DE
   956  05c4  cdef00            	CALL	DELETE
   957  05c7  d1                	POP	DE
   958  05c8  cd0901            	CALL	CREATE		;and create it again.
   959  05cb  ca0106            	JP	Z,SAVE3		;can't create?
   960  05ce  af                	XOR	A		;clear record number byte.
   961  05cf  32f307            	LD	(FCB+32),A
   962  05d2  f1                	POP	AF		;convert pages to sectors.
   963  05d3  6f                	LD	L,A
   964  05d4  2600              	LD	H,0
   965  05d6  29                	ADD	HL,HL		;(HL)=number of sectors to write.
   966  05d7  110001            	LD	DE,TBASE	;and we start from here.
   967  05da  7c                SAVE1:	LD	A,H		;done yet?
   968  05db  b5                	OR	L
   969  05dc  caf705            	JP	Z,SAVE2
   970  05df  2b                	DEC	HL		;nope, count this and compute the start
   971  05e0  e5                	PUSH	HL		;of the next 128 byte sector.
   972  05e1  218000            	LD	HL,128
   973  05e4  19                	ADD	HL,DE
   974  05e5  e5                	PUSH	HL		;save it and set the transfer address.
   975  05e6  cdd801            	CALL	DMASET
   976  05e9  11d307            	LD	DE,FCB		;write out this sector now.
   977  05ec  cd0401            	CALL	WRTREC
   978  05ef  d1                	POP	DE		;reset (DE) to the start of the last sector.
   979  05f0  e1                	POP	HL		;restore sector count.
   980  05f1  c20106            	JP	NZ,SAVE3	;write error?
   981  05f4  c3da05            	JP	SAVE1
   982                          ;
   983                          ;   Get here after writing all of the file.
   984                          ;
   985  05f7  11d307            SAVE2:	LD	DE,FCB		;now close the file.
   986  05fa  cdda00            	CALL	CLOSE
   987  05fd  3c                	INC	A		;did it close ok?
   988  05fe  c20706            	JP	NZ,SAVE4
