   467  0289  3af507            CONVRT1:LD	A,(CDRIVE)
   468  028c  77                	LD	(HL),A
   469  028d  c39602            	JP	CONVRT3
   470  0290  78                CONVRT2:LD	A,B
   471  0291  32f607            	LD	(CHGDRV),A	;set change in drives flag.
   472  0294  70                	LD	(HL),B
