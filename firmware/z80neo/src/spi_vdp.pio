;
; spi_vdp.pio - NullVDP SPI master (z80neo side)
;
; Full-duplex SPI, CPOL=0 CPHA=0, MSB-first, 32-bit frames.  CS is driven by
; the CPU (GPIO).  The state machine is restarted for each transaction; the
; C side configures autopull/autopush at a 32-bit threshold.
;
.program spi_cpha0
.side_set 1

; - SCK is side-set pin 0
; - MOSI is OUT pin 0
; - MISO is IN pin 0
    out pins, 1 side 0 [1]
    in pins, 1  side 1 [1]
