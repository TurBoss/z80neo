// NullVDP - Physical Constraints (UART + HDMI + PS/2)
IO_LOC "clk_27m" H11;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "rst_n" T10;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[0]" L16;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[1]" L14;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[2]" N14;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "led[3]" N16;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "uart_rx" T13;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" M11;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC "ps2_clk" P11;
IO_PORT "ps2_clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "ps2_data" R11;
IO_PORT "ps2_data" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "tmds_clk_p" G16;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_clk_n" H15;
IO_PORT "tmds_clk_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_data_p[0]" H14;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_data_n[0]" H16;
IO_PORT "tmds_data_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_data_p[1]" J15;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_data_n[1]" K16;
IO_PORT "tmds_data_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_data_p[2]" K14;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=3.5;
IO_LOC "tmds_data_n[2]" K15;
IO_PORT "tmds_data_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=3.5;

// USB OTG host (USB3317 ULPI PHY, Dock) — shares banks 0/1 with HDMI
IO_LOC "ulpi_clk" T15;
IO_PORT "ulpi_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "ulpi_dir" K12;
IO_PORT "ulpi_dir" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
